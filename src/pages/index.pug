include ../../src/pug/base/meta
include ../../src/pug/mixin
include ../../src/pug/data/top_data
//- data
include ../../src/pug/data/information_data

doctype html
html
  head
    +meta(
      "サンプルサイト",
      "サンプルサイトの説明文です。",
      "/common/images/ogp.png",
      "https://example.com"
    )

    include ../../src/pug/base/head-assets
  body
    //- include ../../src/pug/base/header

    main.l-main

      section.l-section
        +c-heading('h2', '重要なお知らせ')

        ul.c-information__list
          each item in information_data
            li
              a(href=item.link)
                |!{item.title}


      section.l-section
        +c-heading('h2', 'トピックス')
        .p-topics__list
          each item in topicsData
            +c-card(item.title, false, item.link)


      section.l-section
        +c-heading('h2', '新着・更新', '/')
        .p-news__list
          each item in newsData
            +c-news(item.title, item.tags, item.date, item.link, item.blank)


      section.l-section
        +c-heading('h2', 'ダッシュボード', '/')
        .p-dashboard__list
          each item in dashboardData
            +c-dashboard(item.title, item.description, item.link, item.blank)


    //- include ../../src/pug/base/footer
    include ../../src/pug/base/body-append
