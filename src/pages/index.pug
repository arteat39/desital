include ../../src/pug/base/meta
include ../../src/pug/mixin
include ../../src/pug/data/top_data
//- data
include ../../src/pug/data/information_data

doctype html
html
  head
    +meta(
      "サンプルサイト",
      "サンプルサイトの説明文です。",
      "/common/images/ogp.png",
      "https://example.com"
    )

    include ../../src/pug/base/head-assets
  body
    //- include ../../src/pug/base/header

    main.l-main

      section.l-section
        +c-heading('h2', '重要なお知らせ')

        ul.c-information__list
          each item in information_data
            li
              a(href=item.link)
                |!{item.title}


      section.l-section
        +c-heading('h2', 'トピックス')


      section.l-section
        +c-heading('h2', '新着・更新', '/')



    //- include ../../src/pug/base/footer
    include ../../src/pug/base/body-append
